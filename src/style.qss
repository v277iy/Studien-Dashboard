QWidget {
    font-family: "Liberation Sans", "Arial", sans-serif;
    font-size: 13px;
    color: #1f2937;
}

QWidget#hauptfenster, QWidget#dashboard, QDialog#einrichtung, QDialog#modulDialog {
    background: #ffffff;
}

QScrollArea#modulFormScroll, QWidget#modulFormular, QWidget#modulFormViewport {
    background: #ffffff;
    border: none;
}

QLabel {
    background: transparent;
    border: none;
}

QDialog#modulDialog QLabel:disabled, QDialog#modulDialog QCheckBox:disabled {
    color: #94a3b8;
}

QLabel[rolle="studiengang"] {
    font-size: 27px;
    font-weight: bold;
}

QLabel[rolle="titel"] {
    font-size: 15px;
    font-weight: bold;
}

QLabel[rolle="boardTitel"] {
    font-size: 19px;
    font-weight: bold;
}

QLabel[rolle="wert"] {
    font-size: 25px;
    font-weight: bold;
}

QLabel[rolle="muted"], QLabel[rolle="klein"] {
    color: #64748b;
}

QLabel[rolle="klein"], QLabel[rolle="prozent"] {
    font-size: 11px;
}

QLabel[rolle="prozent"] {
    color: #9a6700;
    font-weight: bold;
}

QLabel[rolle="note"] {
    font-weight: bold;
}

QFrame#kennzahlen {
    background: #f8fafc;
    border: 1px solid #d8e0ea;
    border-radius: 12px;
}

QFrame#trenner {
    background: #d8e0ea;
}

QLabel[rolle="ziel"], QLabel[rolle="status"] {
    font-size: 11px;
    font-weight: bold;
    border-radius: 11px;
    padding: 0 12px;
}

QLabel[rolle="ziel"] {
    background: #edf1f6;
    color: #64748b;
}

QLabel[rolle="zielstatus"] {
    font-size: 11px;
    color: #64748b;
}

QLabel[rolle="ziel"][zustand="erreicht"] {
    background: #dcfce7;
    color: #137333;
}

QLabel[rolle="ziel"][zustand="verfehlt"] {
    background: #fff4d6;
    color: #9a6700;
}

QLabel[rolle="zielstatus"][zustand="erreicht"] {
    color: #137333;
}

QLabel[rolle="zielstatus"][zustand="verfehlt"] {
    color: #9a6700;
}

QFrame#board {
    background: #f5f7fa;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
}

QScrollArea#boardScroll, QWidget#boardViewport, QWidget#boardInhalt {
    background: #f5f7fa;
    border: none;
}

QFrame#spaltenkopf {
    border-radius: 10px;
}

QFrame#spaltenkopf[status="offen"] {
    background: #e7edf5;
}

QFrame#spaltenkopf[status="aktiv"] {
    background: #fff3cf;
}

QFrame#spaltenkopf[status="fertig"] {
    background: #dcfce7;
}

QLabel[rolle="punkt"] {
    border-radius: 7px;
}

QLabel[rolle="punkt"][status="offen"] {
    background: #94a3b8;
}

QLabel[rolle="punkt"][status="aktiv"] {
    background: #f59e0b;
}

QLabel[rolle="punkt"][status="fertig"] {
    background: #22c55e;
}

QLabel[rolle="anzahl"] {
    background: #ffffff;
    border-radius: 11px;
    font-size: 11px;
    font-weight: bold;
}

QFrame#modulkarte {
    background: #ffffff;
    border-radius: 10px;
    border-left: 5px solid #94a3b8;
}

QFrame#modulkarte:hover, QFrame#modulkarte:focus {
    background: #f0f6ff;
}

QFrame#modulkarte[status="aktiv"] {
    border-left-color: #f59e0b;
}

QFrame#modulkarte[status="fertig"] {
    border-left-color: #22c55e;
}

QLabel[rolle="status"][status="offen"] {
    background: #edf1f6;
    color: #64748b;
}

QLabel[rolle="status"][status="aktiv"] {
    background: #fff3cf;
    color: #9a6700;
}

QLabel[rolle="status"][status="fertig"] {
    background: #dcfce7;
    color: #137333;
}

QLabel[rolle="status"][ergebnis="NICHT_BESTANDEN"] {
    background: #fee2e2;
    color: #b91c1c;
}

QProgressBar {
    background: #e2e8f0;
    border: none;
    border-radius: 4px;
}

QProgressBar::chunk {
    background: #3b82f6;
    border-radius: 4px;
}

QProgressBar[status="aktiv"]::chunk {
    background: #f59e0b;
}

QScrollBar:vertical {
    background: #dce3eb;
    width: 8px;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background: #dce3eb;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle {
    background: #9aa9bb;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    min-height: 30px;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page, QScrollArea::corner {
    background: transparent;
}

QLabel[rolle="fehler"] {
    color: #b91c1c;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QDateEdit:disabled, QComboBox:disabled {
    background: #f1f5f9;
    color: #94a3b8;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border-color: #3b82f6;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QDateEdit::drop-down, QComboBox::drop-down {
    subcontrol-origin: border;
    width: 20px;
}

QPushButton {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 16px;
}

QPushButton:hover {
    background: #e7edf5;
}

QPushButton:default {
    background: #3b82f6;
    border-color: #3b82f6;
    color: #ffffff;
}

QPushButton:disabled {
    background: #f1f5f9;
    border-color: #d8e0ea;
    color: #94a3b8;
}

QCalendarWidget, QCalendarWidget QAbstractItemView {
    background: #ffffff;
    color: #1f2937;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #1f2937;
    selection-background-color: #e9f0fb;
    selection-color: #1f2937;
}

QFrame#modulleiste {
    background: #f8fafc;
    border-right: 1px solid #d8e0ea;
}

QToolButton#listenSchalter {
    background: #e3eaf4;
    color: #334155;
    border: none;
    border-radius: 8px;
    font-size: 24px;
}

QToolButton#listenSchalter:hover {
    background: #d8e0ea;
}

QToolButton#listenSchalter:focus {
    border: 1px solid #3b82f6;
}

QListWidget#modulliste {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#modulliste::item {
    border-left: 3px solid transparent;
    border-radius: 8px;
}

QListWidget#modulliste::item:selected {
    background: #e9f0fb;
    border-left-color: #3b82f6;
}

QListWidget#modulliste::item:hover {
    background: #edf1f6;
}

QLabel[rolle="listenTitel"] {
    font-weight: bold;
}

QFrame#listenPunkt {
    border-radius: 5px;
}

QFrame#listenPunkt[status="offen"] {
    background: #94a3b8;
}

QFrame#listenPunkt[status="aktiv"] {
    background: #f59e0b;
}

QFrame#listenPunkt[status="fertig"] {
    background: #22c55e;
}

QPushButton#modulHinzufuegen {
    background: #ffffff;
    border-style: dashed;
    color: #64748b;
}

QPushButton#modulHinzufuegen:hover {
    background: #e9f0fb;
    color: #1f2937;
}
